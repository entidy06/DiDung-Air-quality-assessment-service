# Supabase Cloud project (Project Settings > API Keys) — hệ key mới (sb_publishable_.../sb_secret_...),
# không phải JWT cũ (anon/service_role dạng eyJ...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — CHỈ dùng server-side (API routes), không bao giờ thêm NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Secret bảo vệ /api/sync/* — phải khớp giá trị trong Supabase Vault ('cron_secret'),
# xem supabase/migrations/..._setup_cron_sync_trigger.sql
CRON_SECRET=
# Mapbox public token (pk.*)
NEXT_PUBLIC_MAPBOX_TOKEN=
# 9Router (router.studev.net) — gateway LLM dùng sinh lời khuyên AQI, server-side only
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=https://router.studev.net
NINEROUTER_MODEL=ag/gemini-3.8-flash-low
